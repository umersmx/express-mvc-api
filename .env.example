# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/course_management_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/course_management_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/course_management_db

# JWT Secret Key and Expiration
JWT_SECRET=super_secret_jwt_key_change_in_production_32char_minimum
JWT_EXPIRES_IN=7d
