{
  "info": {
    "_postman_id": "9b12a345-6789-4def-0123-abcdef456789",
    "name": "Course Management REST API (Assignment 2)",
    "description": "Comprehensive Postman collection for the Course Management REST API with JWT authentication, Category CRUD, and Course CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "course_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Token automatically saved to collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@university.edu\",\n  \"password\": \"Secr3tP@ssword!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user, hashes password with bcrypt, and issues a JWT token. Automatically captures token in collection variable."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Token updated in collection variable!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@university.edu\",\n  \"password\": \"Secr3tP@ssword!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user credentials and returns a JWT token. Automatically captures token in collection variable."
          }
        },
        {
          "name": "Get Current User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Retrieves the currently authenticated user's profile based on the JWT token. Password hash is excluded."
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "Create Category (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('category_id', jsonData.data._id);",
                  "    console.log('Category ID saved to collection variable:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Computer Science\",\n  \"description\": \"Core and advanced computing fundamentals, algorithms, and systems engineering.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "categories"]
            },
            "description": "Creates a new category. Requires JWT authentication. Automatically saves category_id for subsequent requests."
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "categories"]
            },
            "description": "Public endpoint to retrieve all categories."
          }
        },
        {
          "name": "Get Category By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "{{category_id}}"]
            },
            "description": "Public endpoint to retrieve a single category by its MongoDB ObjectId."
          }
        },
        {
          "name": "Update Category By ID (Protected)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Computer Science & AI\",\n  \"description\": \"Comprehensive curriculum spanning CS algorithms and artificial intelligence.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "{{category_id}}"]
            },
            "description": "Updates an existing category by ID. Requires JWT authentication."
          }
        },
        {
          "name": "Delete Category By ID (Protected)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/categories/{{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "categories", "{{category_id}}"]
            },
            "description": "Deletes a category. Protected. Blocks deletion with 400 Bad Request if any course still references this category."
          }
        }
      ]
    },
    {
      "name": "3. Courses",
      "item": [
        {
          "name": "Create Course (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('course_id', jsonData.data._id);",
                  "    console.log('Course ID saved to collection variable:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Data Structures and Algorithms Masterclass\",\n  \"description\": \"Comprehensive deep-dive into asymptotic analysis, balanced search trees, graph theory, and dynamic programming.\",\n  \"category\": \"{{category_id}}\",\n  \"price\": 49.99,\n  \"instructor\": \"Dr. Alan Turing\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"]
            },
            "description": "Creates a new course with a validated category reference. Requires JWT authentication."
          }
        },
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"]
            },
            "description": "Public endpoint to retrieve all courses, populated with category and creator info."
          }
        },
        {
          "name": "Filter Courses by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses?category={{category_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"],
              "query": [
                {
                  "key": "category",
                  "value": "{{category_id}}"
                }
              ]
            },
            "description": "Filters courses belonging to a specific category ID."
          }
        },
        {
          "name": "Search Courses by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses?search=Structures",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"],
              "query": [
                {
                  "key": "search",
                  "value": "Structures"
                }
              ]
            },
            "description": "Performs case-insensitive search across course titles."
          }
        },
        {
          "name": "Get Course By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "{{course_id}}"]
            },
            "description": "Public endpoint to retrieve a single course with populated category details."
          }
        },
        {
          "name": "Update Course By ID (Protected)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Data Structures and Graph Algorithms\",\n  \"price\": 59.99\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "{{course_id}}"]
            },
            "description": "Updates course fields. If category is updated, validates category existence. Requires JWT authentication."
          }
        },
        {
          "name": "Delete Course By ID (Protected)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "{{course_id}}"]
            },
            "description": "Deletes a course by ID. Requires JWT authentication."
          }
        }
      ]
    },
    {
      "name": "4. Validation & Edge Cases",
      "item": [
        {
          "name": "Missing Required Fields (Expected 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/courses",
              "host": ["{{base_url}}"],
              "path": ["api", "courses"]
            },
            "description": "Tests validation handler by sending empty body. Expects 400 Bad Request with field details."
          }
        },
        {
          "name": "Unauthorized Request - No Token (Expected 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Category\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "categories"]
            },
            "description": "Tests route protection by omitting Authorization header. Expects 401 Unauthorized."
          }
        },
        {
          "name": "Nonexistent Resource ID (Expected 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses/654321098765432109876543",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "654321098765432109876543"]
            },
            "description": "Tests 404 handling with a validly formatted 24-character hexadecimal ObjectId that does not exist in the database."
          }
        },
        {
          "name": "Malformed Resource ID (Expected 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/courses/not-a-valid-hex-id",
              "host": ["{{base_url}}"],
              "path": ["api", "courses", "not-a-valid-hex-id"]
            },
            "description": "Tests CastError safety by sending an invalid ID string. Expects 400 Bad Request with descriptive message."
          }
        },
        {
          "name": "Unknown Endpoint (Expected 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/unknown-endpoint-route",
              "host": ["{{base_url}}"],
              "path": ["api", "unknown-endpoint-route"]
            },
            "description": "Tests catch-all notFoundHandler middleware. Expects 404 Not Found."
          }
        }
      ]
    },
    {
      "name": "5. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Verifies that the server process is responsive and healthy."
          }
        },
        {
          "name": "Root Welcome",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Root endpoint providing welcome and API catalog overview."
          }
        }
      ]
    }
  ]
}
